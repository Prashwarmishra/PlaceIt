{
  "manifest_version": 3,
  "name": "InPlace",
  "version": "0.1.0",
  "description": "Visualize products in your own space",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Visualize products in your own space"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ]
}

